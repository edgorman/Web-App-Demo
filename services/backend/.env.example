# Service Configuration
SERVICE__FASTAPI__HOST=0.0.0.0
SERVICE__FASTAPI__PORT=8080
SERVICE__FASTAPI__RELOAD=false
SERVICE__FASTAPI__APP_NAME=Web-App-Demo Backend
SERVICE__FASTAPI__APP_VERSION=0.1.0

# CORS Configuration
# Comma-separated list of allowed origins, or use ["*"] to allow all
# SERVICE__CORS__ALLOW_ORIGINS=["https://frontend-example.run.app","https://other-domain.com"]
SERVICE__CORS__ALLOW_CREDENTIALS=true
# SERVICE__CORS__ALLOW_METHODS=["*"]
# SERVICE__CORS__ALLOW_HEADERS=["*"]

# Service Configuration
SERVICE__FASTAPI__HOST=0.0.0.0
SERVICE__FASTAPI__PORT=8080
SERVICE__FASTAPI__RELOAD=false
SERVICE__FASTAPI__APP_NAME=Web-App-Demo Backend
SERVICE__FASTAPI__APP_VERSION=0.1.0

# CORS Configuration
# Comma-separated list of allowed origins (frontend URLs)
# Example: SERVICE__FASTAPI__CORS_ALLOW_ORIGINS=["https://frontend-example.run.app","https://other-domain.com"]
# SERVICE__FASTAPI__CORS_ALLOW_ORIGINS=[]
# SERVICE__FASTAPI__CORS_ALLOW_CREDENTIALS=false
# SERVICE__FASTAPI__CORS_ALLOW_METHODS=["*"]
# SERVICE__FASTAPI__CORS_ALLOW_HEADERS=["*"]

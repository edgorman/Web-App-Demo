SERVICE__FASTAPI__HOST=0.0.0.0
SERVICE__FASTAPI__PORT=8080
SERVICE__FASTAPI__RELOAD=true
SERVICE__FASTAPI__APP_NAME=Web-App-Demo Backend
SERVICE__FASTAPI__APP_VERSION=0.1.0
SERVICE__FASTAPI__CORS__ALLOW_ORIGINS=["http://localhost:3000"]
SERVICE__FASTAPI__CORS__ALLOW_CREDENTIALS=false
SERVICE__FASTAPI__CORS__ALLOW_METHODS=["*"]
SERVICE__FASTAPI__CORS__ALLOW_HEADERS=["*"]
# Google OAuth 2.0 client ID, see:
# https://developers.google.com/identity/gsi/web/guides/get-google-api-clientid
SERVICE__AUTH__GOOGLE__CLIENT_ID=
# GCP project ID for Firestore. Leave empty to use the project from Application
# Default Credentials (e.g. `gcloud auth application-default login`).
SERVICE__STORAGE__FIRESTORE__PROJECT_ID=
# Firestore database ID. Deployed environments use "<project-id>-database"
# (see infrastructure/env/gcp_firestore.tf) — never the literal "(default)" name.
# Leave empty locally to let the Firestore client fall back to its own default
# ("(default)"), or point it at the Firestore emulator or a dev database of your choosing.
SERVICE__STORAGE__FIRESTORE__DATABASE=
